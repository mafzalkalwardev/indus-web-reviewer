# Humanatic portal settings
HUMANATIC_BASE_URL=https://www.humanatic.com/pages/humfun/login.cfm
# Optional: direct review-queue URL after login (leave blank to auto-detect)
HUMANATIC_REVIEW_URL=
HUMANATIC_AUTH_STATE=.auth/humanatic.json
HUMANATIC_BROWSER_PROFILE=.browser-profile

# Humanatic login (enables automatic form login)
HUMANATIC_USERNAME=
HUMANATIC_PASSWORD=

# Grok / xAI / Groq (OpenAI-compatible)
# gsk_ keys auto-use https://api.groq.com/openai/v1
# xAI keys auto-use https://api.x.ai/v1
GROK_API_KEY=
GROK_API_KEY2=
GROK_API_KEY3=
GROK_BASE_URL=
GROK_MODEL=
# Used when primary model hits rate limits (separate quota on Groq)
GROK_FALLBACK_MODEL=llama-3.1-8b-instant

# Free speech-to-text (preferred: Deepgram → AssemblyAI → Groq Whisper)
# Do NOT add OPENAI_API_KEY for Whisper — OpenAI is paid-on-use
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
# Optional future 2nd-opinion LLM (not required)
# GEMINI_API_KEY=

CONFIDENCE_THRESHOLD=0.88
# Accuracy-first: skip low-confidence; pick categories by payout × your site accuracy
ACCURACY_FIRST=1
REVIEW_PLAYBACK_RATE=2.0
# Humanatic Earnings/LB/Accuracy pages: sync every 4h or each +$1 (worker stays on calls)
# LIVE_STATS_HOURS=4

# Cloudflare Turnstile
TURNSTILE_TIMEOUT_MS=120000
TURNSTILE_POLL_MS=1000

# Browser viewport
BROWSER_WIDTH=1440
BROWSER_HEIGHT=900

# Continuous review loop
MAX_REVIEW_CALLS=50
REVIEW_IDLE_TIMEOUT_MS=90000
LOGIN_WAIT_TIMEOUT_MS=600000

# Chrome 136+ blocks --remote-debugging-port on the DEFAULT User Data folder.
# Use a dedicated path (project .chrome-cdp-profile is auto-used if you point at default).
# CHROME_USER_DATA_DIR=D:\path\to\Huamantic Reviewr\.chrome-cdp-profile
# CHROME_PROFILE_DIRECTORY=Default
# SKIP_ANTI_DETECTION=1
# CHROME_DEBUG_PORT=9222

# Practice mode (1 = select only; 0 = live submit)
PRACTICE_MODE=1
# Allow keyword fallback to submit when LLM is down (default off — safer)
HEURISTIC_SUBMIT=0
# Live review listen speed (1–3). Must finish audio before options unlock.
REVIEW_PLAYBACK_RATE=2.5

# Optional runtime tuning
MAX_GROK_RETRIES=3
INITIAL_BACKOFF_MS=1000
MAX_BACKOFF_MS=16000

# Continuous / long-haul
MAX_REVIEW_CALLS=20
REVIEW_IDLE_TIMEOUT_MS=120000
LONG_HAUL_ROUNDS=6
LOGIN_WAIT_TIMEOUT_MS=600000

# Control dashboard API
CONTROL_API_PORT=3847
